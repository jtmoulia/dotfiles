{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "model": "sonnet",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "hog-agent-skills@hog-agent-skills": true,
    "emacs-skills@xenodium-emacs-skills": true
  },
  "extraKnownMarketplaces": {
    "hog-agent-skills": {
      "source": {
        "source": "github",
        "repo": "jtmoulia/hog-agent-skills"
      }
    },
    "xenodium-emacs-skills": {
      "source": {
        "source": "github",
        "repo": "xenodium/emacs-skills"
      }
    }
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "editorMode": "vim",
  "allowedTools": [
    "Bash(~/.claude/bin/workspace *)",
    "Bash(~/.claude/bin/workspace)",
    "Bash(git status*)",
    "Bash(git diff*)",
    "Bash(git log*)",
    "Bash(git show*)",
    "Bash(git branch*)",
    "Bash(git checkout*)",
    "Bash(git switch*)",
    "Bash(git stash*)",
    "Bash(git fetch*)",
    "Bash(git pull*)",
    "Bash(git merge*)",
    "Bash(git rebase*)",
    "Bash(git add*)",
    "Bash(git commit*)",
    "Bash(git rev-parse*)",
    "Bash(git remote*)",
    "Bash(git tag*)",
    "Bash(git check-ignore*)",
    "Bash(ls*)",
    "Bash(find *)",
    "Bash(rg *)",
    "Bash(grep *)",
    "Bash(cat *)",
    "Bash(head *)",
    "Bash(tail *)",
    "Bash(wc *)",
    "Bash(which *)",
    "Bash(whereis *)",
    "Bash(type *)",
    "Bash(file *)",
    "Bash(tree *)",
    "Bash(stat *)",
    "Bash(uname*)",
    "Bash(hostname*)",
    "Bash(df*)",
    "Bash(du*)",
    "Bash(env*)",
    "Bash(printenv*)",
    "Bash(date*)",
    "Bash(gh pr view*)",
    "Bash(gh pr list*)",
    "Bash(gh pr status*)",
    "Bash(gh pr diff*)",
    "Bash(gh issue view*)",
    "Bash(gh issue list*)",
    "Bash(gh repo view*)",
    "Bash(gh run list*)",
    "Bash(gh run view*)",
    "Bash(gog *)"
  ]
}
